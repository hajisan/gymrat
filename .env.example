# =========================================
# GYMRAT ENVIRONMENT VARIABLES
# =========================================
# Kopier denne fil til .env og udfyld værdierne
# =========================================

# Database
DB_URL=jdbc:mysql://your-db-host:3306/gymrat
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Authentication
AUTH_USERNAME=your_admin_username
AUTH_PASSWORD=your_secure_password

# CORS (dit domæne)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Security (generer med: python3 -c "import secrets; print(secrets.token_hex(32))")
REMEMBER_ME_KEY=your_random_64_char_hex_string